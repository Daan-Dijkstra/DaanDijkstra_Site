---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { bepaalThumbnail } from '../lib/project-images';

const projecten = (await getCollection('projecten')).sort(
  (a, b) => a.data.volgorde - b.data.volgorde
);
---

<BaseLayout titel="Portfolio" actief="portfolio" beschrijving="Overzicht van alle projecten van DD-Industries, Daan Dijkstra.">
  <section style="border-top: none; padding-top: 3rem;">
    <span class="section-label">Portfolio</span>
    <h2 class="section-titel">Mijn projecten en producten</h2>
    <p>Klik op een project voor meer foto's en uitleg.</p>
    <div class="gallery">
      {projecten.map((project) => {
        const thumb = bepaalThumbnail(project.data);
        return (
          <figure>
            <a href={`/projecten/${project.slug}`}>
              {thumb && <img src={thumb} alt={project.data.title} />}
              <figcaption>{project.data.title}</figcaption>
            </a>
          </figure>
        );
      })}
    </div>
  </section>
</BaseLayout>
