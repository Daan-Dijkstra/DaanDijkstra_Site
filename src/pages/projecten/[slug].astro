---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { leesProjectFotos } from '../../lib/project-images';

export async function getStaticPaths() {
  const projecten = await getCollection('projecten');
  return projecten.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const categorieen = project.data.categorieMappen?.map((cat) => ({
  naam: cat.naam,
  fotos: leesProjectFotos(cat.map, `${project.data.title} - ${cat.naam}`),
}));

const enkeleFotos = project.data.map
  ? leesProjectFotos(project.data.map, project.data.title)
  : [];
---

<BaseLayout titel={project.data.title} actief="portfolio" beschrijving={project.data.beschrijving}>
  <section style="border-top: none; padding-top: 3rem;">
    <span class="section-label">Project</span>
    <h2 class="section-titel">{project.data.title}</h2>
    <p>{project.data.beschrijving}</p>
    <Content />
  </section>

  {categorieen && categorieen.length > 0 ? (
    categorieen.map((categorie) => (
      <section>
        <span class="section-label">{categorie.naam}</span>
        <div class="project-fotos">
          {categorie.fotos.map((foto) => (
            <figure>
              <img src={foto.src} alt={foto.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </section>
    ))
  ) : (
    <section>
      <span class="section-label">Fotogalerij</span>
      <div class="project-fotos">
        {enkeleFotos.map((foto) => (
          <figure>
            <img src={foto.src} alt={foto.alt} loading="lazy" />
          </figure>
        ))}
      </div>
    </section>
  )}

  <p><a href="/portfolio" class="btn btn-secundair">&larr; Terug naar portfolio</a></p>
</BaseLayout>
