---
import '../styles/global.css';

interface Props {
  titel: string;
  beschrijving?: string;
  actief?: 'home' | 'portfolio' | 'contact';
}

const {
  titel,
  beschrijving = "Daan Dijkstra - maker, ontwerper en aannemer. Portfolio en blog.",
  actief = '',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={beschrijving} />
    <title>{titel} - Daan Dijkstra</title>

    <!-- Open Graph tags voor nette previews bij delen -->
    <meta property="og:title" content={`${titel} - Daan Dijkstra`} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <h1>Daan Dijkstra</h1>
      <p>Maker van producten en projecten</p>
      <nav>
        <ul>
          <li><a href="/" class={actief === 'home' ? 'actief' : ''}>Home</a></li>
          <li><a href="/portfolio" class={actief === 'portfolio' ? 'actief' : ''}>Portfolio</a></li>
          <li><a href="/contact" class={actief === 'contact' ? 'actief' : ''}>Contact</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Daan Dijkstra. Alle rechten voorbehouden.</p>
    </footer>
  </body>
</html>
