---
import '../styles/global.css';

interface Props {
  titel: string;
  beschrijving?: string;
  actief?: 'home' | 'portfolio' | 'over' | 'contact';
  deelplaatje?: string;
}

const {
  titel,
  beschrijving = "DD-Industries - vakwerk van Daan Dijkstra. Maatwerk, restauratie en hergebruikt materiaal.",
  actief = '',
  deelplaatje = "/images-opt/Broedplaats/Ceuvel - Daan-03.webp",
} = Astro.props;

// Social media vereist een absolute URL voor het deelplaatje
const deelplaatjeUrl = new URL(deelplaatje, Astro.site).href;
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={beschrijving} />
    <title>{titel} - DD-Industries</title>

    <meta property="og:title" content={`${titel} - DD-Industries`} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={deelplaatjeUrl} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content="DD-Industries" />
    <meta property="og:locale" content="nl_NL" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${titel} - DD-Industries`} />
    <meta name="twitter:description" content={beschrijving} />
    <meta name="twitter:image" content={deelplaatjeUrl} />

    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="36" height="36">
              <rect x="1" y="1" width="46" height="46" rx="4" fill="none" stroke="currentColor" stroke-width="2"/>
              <text x="24" y="31" text-anchor="middle" font-family="Oswald, sans-serif" font-weight="600" font-size="20" fill="currentColor">DD</text>
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-name">DD&#8209;INDUSTRIES</span>
            <span class="brand-sub">by Daan Dijkstra</span>
          </span>
        </a>

        <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="Menu openen">
          <span></span><span></span><span></span>
        </button>

        <nav id="siteNav" class="site-nav">
          <ul>
            <li><a href="/" class={actief === 'home' ? 'actief' : ''}>Home</a></li>
            <li><a href="/#projecten" class={actief === 'portfolio' ? 'actief' : ''}>Portfolio</a></li>
            <li><a href="/over" class={actief === 'over' ? 'actief' : ''}>Over mij</a></li>
            <li><a href="/contact" class={actief === 'contact' ? 'actief' : ''}>Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span class="brand-mark small" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="26" height="26">
          <rect x="1" y="1" width="46" height="46" rx="4" fill="none" stroke="currentColor" stroke-width="2"/>
          <text x="24" y="31" text-anchor="middle" font-family="Oswald, sans-serif" font-weight="600" font-size="20" fill="currentColor">DD</text>
        </svg>
      </span>
      <p>&copy; {new Date().getFullYear()} DD-Industries &mdash; Daan Dijkstra. Alle rechten voorbehouden.</p>
    </footer>

    <script>
      const toggle = document.getElementById('navToggle');
      const nav = document.getElementById('siteNav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    </script>
  </body>
</html>
